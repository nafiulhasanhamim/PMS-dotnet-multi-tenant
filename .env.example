# Copy to .env and edit. docker-compose.yml reads these; every one has a working default, so an
# empty .env (or none at all) still brings the stack up.
#
#   cp .env.example .env
#
# .env is gitignored. .env.example is not — keep secrets out of it.

# ── Host ports ──────────────────────────────────────────────────────────────────────────────
#
# Set any of these if something on your machine already holds the default. The containers talk
# to each other on fixed internal ports regardless; these only affect what the host sees.

WEB_PORT=8080          # the Razor frontend  → http://<pharmacy>.localhost:8080
API_PORT=8081          # the API + Swagger   → http://localhost:8081/swagger
SQL_PORT=14330         # SQL Server, for SSMS or Azure Data Studio
DASHBOARD_PORT=18888   # Aspire dashboard UI      (only with --profile telemetry)
OTLP_PORT=4317         # OTLP gRPC from the host  (only with --profile telemetry)

# ── Telemetry (off by default) ──────────────────────────────────────────────────────────────
#
# The Aspire dashboard is NOT started by `docker compose up`. It is not part of the
# application, and if you used an earlier version of this compose file you already have a
# standalone aspire-dashboard container holding 18888 and 4317 — a second one fails to bind.
#
# OTEL_EXPORTER_OTLP_ENDPOINT is left empty unless you set OTLP_ENDPOINT below. That is
# deliberate: ServiceDefaults only wires the exporter when it is non-empty, so empty means
# no exporter rather than an app retrying against a dashboard nobody started.
#
# Two ways to turn it on.
#
# (a) Use this stack's own dashboard:
#         docker compose --profile telemetry up -d
#     and uncomment:
# OTLP_ENDPOINT=http://aspire-dashboard:18889
#
# (b) Send to a dashboard ALREADY running on your machine — likely if you also run the
#     app from Visual Studio. No profile needed; the containers reach the host by name:
# OTLP_ENDPOINT=http://host.docker.internal:4317

# ── Database ────────────────────────────────────────────────────────────────────────────────
#
# SQL Server refuses a weak one: at least 8 characters, with three of upper, lower, digit and
# symbol. Changing this after the first `up` will NOT change the sa password — that lives in the
# pms-mssql volume. Drop the volume, or change it with ALTER LOGIN.

MSSQL_SA_PASSWORD=Dev_Passw0rd!23

# ── First sign-in ───────────────────────────────────────────────────────────────────────────
#
# The API seeds this account on startup so there is somebody who can create a pharmacy. Without
# it a fresh database has no way in at all. Seeding is idempotent and never creates a second.
#
# Sign in at http://localhost:8080/platform/login

PLATFORM_ADMIN_EMAIL=platform@pms.local
PLATFORM_ADMIN_PASSWORD=Platform@123

# ── Token signing ───────────────────────────────────────────────────────────────────────────
#
# The API refuses to start without this and has no built-in default, because a predictable
# signing key lets anyone mint a token for any pharmacy. At least 32 bytes.
#
# The value below is fine for a laptop and nowhere else. Generate a real one with:
#   openssl rand -base64 48

JWT_SIGNING_KEY=dev-only-signing-key-change-me-at-least-32-bytes-long

# ── Tenancy ─────────────────────────────────────────────────────────────────────────────────
#
# A pharmacy is reached at <its-domain>.<base domain>. Browsers resolve anything under
# .localhost to 127.0.0.1 without a hosts-file entry, which is what makes the subdomain model
# work locally. Point this at a real domain when deploying behind a wildcard certificate.

TENANCY_BASE_DOMAIN=localhost

# ── Display ─────────────────────────────────────────────────────────────────────────────────
#
# Storage and reporting are UTC throughout; this only affects how times are shown.

DISPLAY_TIMEZONE=Asia/Dhaka
