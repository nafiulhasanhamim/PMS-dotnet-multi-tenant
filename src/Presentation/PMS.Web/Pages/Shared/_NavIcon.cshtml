@*
    The icon set, in one place. Inline SVG rather than an icon font: no extra request,
    no flash of missing glyphs, and it inherits currentColor so the active nav state
    needs no separate rule.

    Icons here are decorative - every nav item and button also carries text - so they
    are aria-hidden. An icon-only control must supply its own aria-label.
*@
@model string
@{
    var path = Model switch
    {
        "grid" => "M3 3h7v7H3V3zm11 0h7v7h-7V3zM3 14h7v7H3v-7zm11 0h7v7h-7v-7z",
        "people" => "M16 11a4 4 0 10-8 0 4 4 0 008 0zM2 21a6 6 0 0112 0M17 21a5 5 0 00-3-4.58A4 4 0 1018 8",
        "person" => "M12 12a4 4 0 100-8 4 4 0 000 8zM4 21a8 8 0 0116 0",
        "building" => "M4 21V5a2 2 0 012-2h8a2 2 0 012 2v16M16 9h2a2 2 0 012 2v10M8 7h4M8 11h4M8 15h4M2 21h20",
        "check" => "M20 6L9 17l-5-5",
        "alert" => "M12 9v4M12 17h.01M10.3 3.3L2 18a2 2 0 001.7 3h16.6a2 2 0 001.7-3L13.7 3.3a2 2 0 00-3.4 0z",
        "info" => "M12 16v-4M12 8h.01M12 22a10 10 0 100-20 10 10 0 000 20z",
        "menu" => "M3 6h18M3 12h18M3 18h18",
        _ => "M12 22a10 10 0 100-20 10 10 0 000 20z",
    };
}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="@path" />
</svg>
