@page "/medicines"
@model PMS.Web.Pages.Medicines.IndexModel
@{
    ViewData["Title"] = "Medicines";
    var canWrite = User.IsTenantAdmin() || User.Role() == UserRole.Pharmacist;
    var canDeactivate = User.IsTenantAdmin();
    var showPrices = canWrite;
}

<div class="pms-page-header">
    <div>
        <h1>Medicines</h1>
        <p class="pms-page-header__subtitle">What this pharmacy stocks, with your own prices.</p>
    </div>
    @if (canWrite)
    {
        <div class="pms-page-header__actions">
            <a class="btn btn-primary" asp-page="/Medicines/Import">Import from catalog</a>
            <a class="btn btn-outline-secondary" asp-page="/Medicines/Create">Add manually</a>
        </div>
    }
</div>

<partial name="_Alert" model="@AlertModel.Danger(Model.FormError)" />

@* Dismissible, and it comes back on the next page load while any product is still unpriced -
   the count is the point, not the notification. Only shown when the list is not already
   filtered to them, because then the whole page is the message. *@
@if (Model.IncompleteCount > 0 && Model.Status != ProductStatusFilter.SetupIncomplete)
{
    <div class="pms-alert pms-alert--warning d-flex justify-content-between align-items-center"
         data-dismissible-banner="setup-incomplete">
        <div>
            <strong>@Model.IncompleteCount</strong>
            @(Model.IncompleteCount == 1 ? "product needs" : "products need") prices before
            @(Model.IncompleteCount == 1 ? "it" : "they") can be sold.
            <a asp-page="/Medicines/CompleteSetup">Complete setup</a>
        </div>
        <button type="button" class="btn-close" aria-label="Dismiss"
                data-dismiss-banner></button>
    </div>
}

<form method="get" class="pms-card mb-3">
    <div class="pms-card__body">
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="pms-form-label" for="q">Search</label>
                <input class="form-control" id="q" name="q" value="@Model.Search"
                       placeholder="Search by brand or generic name..." />
            </div>
            <div class="col-md-3">
                <label class="pms-form-label" for="status">Status</label>
                <select class="form-select" id="status" name="status">
                    @foreach (var option in new[]
                        {
                            ProductStatusFilter.Active,
                            ProductStatusFilter.Inactive,
                            ProductStatusFilter.SetupIncomplete,
                            ProductStatusFilter.All,
                        })
                    {
                        <option value="@option" selected="@(Model.Status == option)">
                            @(option switch
                            {
                                ProductStatusFilter.All => "All",
                                ProductStatusFilter.SetupIncomplete => "Setup incomplete",
                                _ => option.ToString(),
                            })
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" id="abx" name="abx"
                           value="true" checked="@Model.AntibioticOnly" />
                    <label class="form-check-label" for="abx">Antibiotics only</label>
                </div>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary w-100">Search</button>
            </div>
        </div>
    </div>
</form>

<div class="pms-table-wrap">
    @if (Model.Products.IsEmpty)
    {
        @if (Model.HasFilters)
        {
            <partial name="_EmptyState" model="@(new EmptyStateModel(
                "No medicines match your search."))" />
            <div class="pms-empty pt-0">
                <a asp-page="/Medicines/Index">Clear filters</a>
            </div>
        }
        else
        {
            <partial name="_EmptyState" model="@(new EmptyStateModel(
                "No medicines yet",
                "Import from the catalog or add one manually.",
                canWrite ? "Import from catalog" : null,
                canWrite ? "/Medicines/Import" : null))" />
        }
    }
    else
    {
        <div class="table-responsive">
            <table class="pms-table">
                <caption class="visually-hidden">Medicines this pharmacy stocks</caption>
                <thead>
                    <tr>
                        <th scope="col">Brand name</th>
                        <th scope="col">Generic name</th>
                        <th scope="col">Company</th>
                        <th scope="col">Dosage form</th>
                        <th scope="col">Strength</th>
                        @* Prices are absent from the response for an Employee, so the column
                           is not rendered for them either. The API is the control; this is
                           just not showing an empty column. *@
                        @if (showPrices)
                        {
                            <th scope="col">Price</th>
                        }
                        <th scope="col">Antibiotic</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="pms-col-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products.Data)
                    {
                        var status = ProductPresentation.StatusBadge(product.IsActive);
                        var formId = $"product-active-{product.Id}";
                        <tr class="@(product.IsActive ? null : "pms-row-inactive")">
                            <td>
                                <a asp-page="/Products/Detail" asp-route-id="@product.Id">@product.BrandName</a>
                            </td>
                            <td>@(product.GenericName ?? "—")</td>
                            <td>@(product.Company ?? "—")</td>
                            <td>@(product.DosageForm ?? "—")</td>
                            <td>@(product.Strength ?? "—")</td>
                            @if (showPrices)
                            {
                                <td>@(product.PricePerBase is { } price
                                        ? $"৳{price:N2} / {product.BaseUnitName}"
                                        : "—")</td>
                            }
                            <td>
                                @if (product.IsAntibiotic)
                                {
                                    @* Prominent on purpose: this flag drives who may sell the
                                       product and whether a prescription must be captured. *@
                                    <span class="pms-badge pms-badge--danger" title="Regulated antibiotic">
                                        AB
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <span class="pms-badge @status.Css">@status.Text</span>
                                @if (ProductPresentation.SetupBadge(product.IsSetupComplete)
                                        is { } setup)
                                {
                                    @* Amber, and alongside rather than instead of Active: the
                                       product is active AND not yet sellable, and showing one
                                       badge would lose half of that. *@
                                    <span class="pms-badge @setup.Css" title="@setup.Title">
                                        @setup.Text
                                    </span>
                                }
                            </td>
                            <td class="pms-col-actions">
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-page="/Products/Detail" asp-route-id="@product.Id">View</a>

                                @if (canWrite)
                                {
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-page="/Products/Edit" asp-route-id="@product.Id">Edit</a>
                                }

                                @if (canDeactivate)
                                {
                                    <form method="post" id="@formId" class="d-inline"
                                          asp-page-handler="Active"
                                          asp-route-id="@product.Id"
                                          asp-route-q="@Model.Search"
                                          asp-route-status="@Model.Status"
                                          asp-route-abx="@Model.AntibioticOnly"
                                          asp-route-p="@Model.Products.Page">
                                        <input type="hidden" name="isActive"
                                               value="@((!product.IsActive).ToString().ToLowerInvariant())" />
                                        @if (product.IsActive)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    data-pms-confirm-form="@formId"
                                                    data-pms-confirm-title="Deactivate this product?"
                                                    data-pms-confirm-ok="Deactivate"
                                                    data-pms-confirm="This product will no longer appear in default lists or be available for new purchases and sales. You can reactivate it later. Existing stock and historical records are preserved.">
                                                Deactivate
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                <span class="pms-spinner" aria-hidden="true"></span>Reactivate
                                            </button>
                                        }
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_ApiPagination" model="@(ApiPaginationModel.For(
            Model.Products, "/Medicines/Index", new Dictionary<string, string>
            {
                ["q"] = Model.Search ?? string.Empty,
                ["status"] = Model.Status.ToString(),
                ["abx"] = Model.AntibioticOnly.ToString(),
            }))" />
    }
</div>
