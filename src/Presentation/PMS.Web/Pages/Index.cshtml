@page "/"
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

@if (Model.Profile is { } profile)
{
    <div class="pms-page-header">
        <div>
            <h1>Welcome, @profile.FullName</h1>
            <p class="pms-page-header__subtitle">
                You are signed in to <strong>@profile.Tenant.Name</strong>
                as @StatusPresentation.ForRole(profile.Role).Text.ToLowerInvariant().
            </p>
        </div>
        <div class="pms-page-header__actions">
            <a class="btn btn-primary" asp-page="/Billing/Index">New sale</a>
        </div>
    </div>

    @* ── Module 6: what needs attention ──────────────────────────────────────────────── *@
    @if (Model.AlertsUnavailable)
    {
        <partial name="_Alert" model="@AlertModel.Warning(
            "Stock alerts could not be loaded just now. Everything else on this page is "
            + "current.")" />
    }
    else
    {
        <section aria-label="Stock alerts" class="mb-4">
            <div class="pms-alert-grid">
                @foreach (var card in Model.Cards)
                {
                    <partial name="_AlertCard" model="@card" />
                }
            </div>

            @if (!Model.Summary.HasAnything)
            {
                @* Said once, quietly, instead of four green ticks. *@
                <p class="pms-form-help mt-2 mb-0">
                    Nothing needs attention: every product is above its reorder level and
                    nothing is within @Model.Summary.ExpiryWindowDays days of expiry.
                </p>
            }
        </section>
    }

    <div class="row g-3">
        <div class="col-lg-5">
            <section class="pms-card h-100">
                <div class="pms-card__header">
                    <h2>Current pharmacy</h2>
                </div>
                <div class="pms-card__body">
                    <dl class="pms-detail-list">
                        <dt>Pharmacy</dt>
                        <dd>@profile.Tenant.Name</dd>

                        <dt>Domain</dt>
                        <dd><span class="pms-mono">@profile.Tenant.DomainName</span></dd>

                        <dt>Your role here</dt>
                        <dd>
                            @{
                                var role = StatusPresentation.ForRole(profile.Role);
                            }
                            <span class="pms-badge @role.Css">@role.Text</span>
                        </dd>

                        <dt>Signed in as</dt>
                        <dd>@profile.Email</dd>
                    </dl>
                </div>
            </section>
        </div>

        <div class="col-lg-7">
            <section class="pms-card h-100">
                <div class="pms-card__header">
                    <h2>Daily operations</h2>
                </div>
                <div class="pms-card__body">
                    <div class="pms-placeholder">
                        <p class="mb-2">
                            <strong>More panels arrive with their modules.</strong>
                        </p>
                        <p class="mb-0">
                            Stock alerts are above. Today&rsquo;s takings, outstanding purchase
                            orders and the antibiotic register each arrive with Modules 4, 7
                            and 8.
                        </p>
                    </div>
                </div>
            </section>
        </div>
    </div>
}
else
{
    <partial name="_Alert" model="@AlertModel.Danger(Model.FormError)" />
}
