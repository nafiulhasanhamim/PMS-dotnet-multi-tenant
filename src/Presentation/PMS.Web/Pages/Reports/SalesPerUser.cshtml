@page "/reports/sales-per-user"
@model PMS.Web.Pages.Reports.SalesPerUserModel
@{
    ViewData["Title"] = "Sales per user";

    var chart = new ChartModel
    {
        Points = Model.Rows
            .Select(r => new ChartPoint(
                r.Name.Split(' ')[0],
                r.TotalSales,
                $"{r.Name} - {Money.Format(r.TotalSales)} over "
                    + $"{r.TransactionCount} transactions"))
            .ToList(),
        Height = 150,
        EmptyMessage = "Nobody rang up a sale in this period.",
    };
}

<div class="pms-page-header pms-no-print">
    <div>
        <h1>Sales per user</h1>
        <p class="pms-page-header__subtitle">
            What each person at the counter rang up, and how much discount they gave.
        </p>
    </div>
    <div class="pms-page-header__actions">
        <a class="btn btn-outline-secondary" asp-page-handler="Export"
           asp-all-route-data="Model.RouteValues">Export CSV</a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print();">
            Print
        </button>
    </div>
</div>

<div class="pms-print-only pms-print-header">
    <h1>Sales per user</h1>
    <p class="mb-1"><strong>@Model.PharmacyName</strong></p>
    <p class="mb-0">
        @Model.From?.ToString("d MMM yyyy") &ndash; @Model.To?.ToString("d MMM yyyy")
    </p>
</div>

@if (TempData["ExportFailed"] is string exportError)
{
    <partial name="_Alert" model="@AlertModel.Warning(exportError)" />
}

@if (Model.FormError is not null)
{
    <partial name="_Alert" model="@AlertModel.Danger(Model.FormError)" />
}

<form method="get" class="report-filters pms-no-print">
    <div class="report-filter">
        <label class="pms-form-label" for="from">From</label>
        <input type="date" class="form-control" id="from" name="from"
               value="@Model.From?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="report-filter">
        <label class="pms-form-label" for="to">To</label>
        <input type="date" class="form-control" id="to" name="to"
               value="@Model.To?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="report-filter report-filter--actions">
        <button type="submit" class="btn btn-primary">Apply</button>
        <a class="btn btn-link" asp-page="/Reports/SalesPerUser">Reset</a>
    </div>
</form>

@if (Model.Rows.Count == 0)
{
    <partial name="_EmptyState" model="@(new EmptyStateModel(
        "No sales in this period",
        "Nobody rang anything up between these dates."))" />
}
else
{
    <section class="report-section">
        <h2 class="h6">Sales by person</h2>
        <partial name="_BarChart" model="chart" />
    </section>

    <section class="report-section">
        <div class="pms-table-wrap">
            <table class="pms-table">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">Role</th>
                        <th scope="col" class="text-end">Transactions</th>
                        <th scope="col" class="text-end">Total sales</th>
                        <th scope="col" class="text-end">Average sale</th>
                        <th scope="col" class="text-end">Discount given</th>
                        <th scope="col" class="text-end">Average discount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>@row.Name</td>
                            <td>
                                @if (row.Role is { } role)
                                {
                                    <span class="pms-badge pms-badge--neutral">@role</span>
                                }
                                else
                                {
                                    @* Sales outlive the account that made them. A row with no
                                       role is somebody whose access was removed, and dropping it
                                       would drop their sales out of the total too. *@
                                    <span class="pms-placeholder">&mdash;</span>
                                }
                            </td>
                            <td class="text-end">@Money.Count(row.TransactionCount)</td>
                            <td class="text-end">@Money.Format(row.TotalSales)</td>
                            <td class="text-end">
                                @Money.Format(row.TransactionCount == 0
                                    ? 0m
                                    : row.TotalSales / row.TransactionCount)
                            </td>
                            <td class="text-end">@Money.Format(row.TotalDiscount)</td>
                            <td class="text-end">@Money.Percent(row.AverageDiscountPercent)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th scope="row" colspan="2">All</th>
                        <td class="text-end">@Money.Count(Model.TotalTransactions)</td>
                        <td class="text-end">@Money.Format(Model.TotalSales)</td>
                        <td class="text-end">
                            @Money.Format(Model.TotalTransactions == 0
                                ? 0m
                                : Model.TotalSales / Model.TotalTransactions)
                        </td>
                        <td class="text-end">
                            @Money.Format(Model.Rows.Sum(r => r.TotalDiscount))
                        </td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </section>

    @*
        Said plainly, because a table that ranks colleagues invites a conclusion the numbers do
        not support on their own. Anyone opening this page should read it before they read the
        discount column.
    *@
    <div class="report-note">
        <h2 class="h6">Reading this fairly</h2>
        <p>
            A discount figure well above everyone else's is a question, not a finding. Counters
            differ: one shift serves the regulars, another the walk-ins, and a manager may have
            authorised goodwill that only one person was on hand to apply. The average discount is
            a share of what each person rang up before discount, so it is comparable between
            people &mdash; but it does not know who they were serving.
        </p>
        <p class="mb-0">
            Cancelled sales are excluded entirely, so a cashier is not counted for a sale that was
            reversed.
        </p>
    </div>
}
