@page "/reports/monthly-sales"
@model PMS.Web.Pages.Reports.MonthlySalesModel
@{
    ViewData["Title"] = "Monthly sales and profit";

    var report = Model.Report;

    var salesChart = new ChartModel
    {
        Points = report.Days
            .Select(d => new ChartPoint(
                d.Date.Day.ToString(),
                d.Sales,
                $"{d.Date:d MMM} - {Money.Format(d.Sales)} over {d.TransactionCount} sales"))
            .ToList(),
        Height = 170,
        LabelEvery = 5,
        EmptyMessage = "No sales in this month.",
    };

    var profitChart = new ChartModel
    {
        Points = report.Days
            .Select(d => new ChartPoint(
                d.Date.Day.ToString(),
                d.Profit,
                $"{d.Date:d MMM} - {Money.Signed(d.Profit)} profit"))
            .ToList(),
        Height = 140,
        LabelEvery = 5,
        Tone = "chart-profit",
        EmptyMessage = "No profit to chart for this month.",
    };
}

<div class="pms-page-header pms-no-print">
    <div>
        <h1>Monthly sales &amp; profit</h1>
        <p class="pms-page-header__subtitle">@report.MonthName</p>
    </div>
    <div class="pms-page-header__actions">
        <a class="btn btn-outline-secondary" asp-page-handler="Export"
           asp-all-route-data="Model.RouteValues">Export CSV</a>
        <button type="button" class="btn btn-outline-secondary" onclick="window.print();">
            Print
        </button>
    </div>
</div>

<div class="pms-print-only pms-print-header">
    <h1>Monthly sales and profit</h1>
    <p class="mb-1"><strong>@Model.PharmacyName</strong></p>
    <p class="mb-0">@report.MonthName</p>
</div>

@if (TempData["ExportFailed"] is string exportError)
{
    <partial name="_Alert" model="@AlertModel.Warning(exportError)" />
}

@if (Model.FormError is not null)
{
    <partial name="_Alert" model="@AlertModel.Danger(Model.FormError)" />
}

<form method="get" class="report-filters pms-no-print">
    <div class="report-filter">
        <label class="pms-form-label" for="month">Month</label>
        <select class="form-select" id="month" name="month"
                onchange="this.form.year.value = this.selectedOptions[0].dataset.year;
                          this.form.submit();">
            @foreach (var option in Model.MonthOptions)
            {
                <option value="@option.Month" data-year="@option.Year"
                        selected="@(option.Month == report.Month && option.Year == report.Year)">
                    @option.ToString("MMMM yyyy")
                </option>
            }
        </select>
    </div>
    <input type="hidden" name="year" value="@report.Year" />
    <div class="report-filter report-filter--actions">
        <a class="btn btn-outline-secondary" asp-page="/Reports/MonthlySales"
           asp-route-month="@Model.Previous.Month" asp-route-year="@Model.Previous.Year">
            &larr; @Model.Previous.ToString("MMM")
        </a>
        @if (Model.HasNext)
        {
            <a class="btn btn-outline-secondary" asp-page="/Reports/MonthlySales"
               asp-route-month="@Model.Next.Month" asp-route-year="@Model.Next.Year">
                @Model.Next.ToString("MMM") &rarr;
            </a>
        }
        <noscript>
            <button type="submit" class="btn btn-primary">Show</button>
        </noscript>
    </div>
</form>

<div class="stat-cards">
    <div class="stat-card">
        <span class="stat-card__label">Total sales</span>
        <span class="stat-card__value">@Money.Format(report.TotalSales)</span>
        <span class="stat-card__note">@Money.Count(report.TransactionCount) transactions</span>
    </div>
    <div class="stat-card">
        <span class="stat-card__label">Gross profit</span>
        <span class="stat-card__value @Money.Tone(report.GrossProfit)">
            @Money.Signed(report.GrossProfit)
        </span>
        <span class="stat-card__note">@Money.Percent(report.MarginPercent) margin</span>
    </div>
    <div class="stat-card">
        <span class="stat-card__label">Operating expenses</span>
        <span class="stat-card__value">@Money.Format(report.OperatingExpenses)</span>
        <span class="stat-card__note">Salaries and advances</span>
    </div>
    <div class="stat-card stat-card--emphasis">
        <span class="stat-card__label">Net profit</span>
        <span class="stat-card__value @Money.Tone(report.NetProfit)">
            @Money.Signed(report.NetProfit)
        </span>
        <span class="stat-card__note">Gross profit less operating expenses</span>
    </div>
</div>

@if (report.NoExpensesRecorded)
{
    @*
        Module 8 rendered a note here saying salaries were not yet recorded anywhere. Module 9
        built them, so the note now says what is actually true of this month: nothing went out.

        It is kept rather than deleted because zero staff cost in a trading month almost always
        means a payroll generated and not yet marked paid, not a month where nobody was paid.
        Somebody reading "net profit" is entitled to know which.
    *@
    <partial name="_Alert" model="@AlertModel.Info(
        "No salaries were paid and no advances were given in this month, so net profit above is "
        + "the same as gross profit. If staff were paid, check that the month's payroll has been "
        + "marked paid on the Salary screen.")" />
}

<section class="report-section">
    <h2 class="h6">Sales through the month</h2>
    <partial name="_BarChart" model="salesChart" />
</section>

<section class="report-section">
    <h2 class="h6">Profit through the month</h2>
    <partial name="_LineChart" model="profitChart" />
</section>

<section class="report-section">
    <h2 class="h6">Day by day</h2>

    @if (report.Days.Count == 0)
    {
        <partial name="_EmptyState" model="@(new EmptyStateModel(
            "Nothing to show",
            "This month has no days to report on."))" />
    }
    else
    {
        <div class="pms-table-wrap">
            <table class="pms-table">
                <thead>
                    <tr>
                        <th scope="col">Date</th>
                        <th scope="col" class="text-end">Transactions</th>
                        <th scope="col" class="text-end">Sales</th>
                        <th scope="col" class="text-end">Profit</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var day in report.Days)
                    {
                        @* A day with nothing is shown, greyed. Skipping it would make a quiet
                           Friday look like missing data rather than a quiet Friday. *@
                        <tr class="@(day.TransactionCount == 0 ? "row-quiet" : null)">
                            <td>
                                <a asp-page="/Reports/DailySales"
                                   asp-route-date="@day.Date.ToString("yyyy-MM-dd")">
                                    @day.Date.ToString("ddd d MMM")
                                </a>
                            </td>
                            <td class="text-end">@Money.Count(day.TransactionCount)</td>
                            <td class="text-end">@Money.Format(day.Sales)</td>
                            <td class="text-end @Money.Tone(day.Profit)">
                                @Money.Signed(day.Profit)
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th scope="row">Total</th>
                        <td class="text-end">@Money.Count(report.TransactionCount)</td>
                        <td class="text-end">@Money.Format(report.TotalSales)</td>
                        <td class="text-end @Money.Tone(report.GrossProfit)">
                            @Money.Signed(report.GrossProfit)
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</section>

@if (report.TotalRefunded != 0)
{
    <p class="report-section__note">
        @Money.Format(report.TotalRefunded) was refunded this month, which cost
        @Money.Format(report.ReturnImpact) of profit &mdash; the refunds less the cost of the
        stock that came back onto the shelves. Both are already in the figures above.
    </p>
}
