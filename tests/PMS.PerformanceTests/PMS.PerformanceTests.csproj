<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <RootNamespace>PMS.PerformanceTests</RootNamespace>
    <StartupObject>PMS.PerformanceTests.PerformanceTestRunner</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Benchmarking -->
    <PackageReference Include="BenchmarkDotNet" />

    <!-- Load Testing -->
    <PackageReference Include="NBomber" />
    <PackageReference Include="NBomber.Http" />

    <!-- Testing Framework -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- EF Core for benchmarks -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />

    <!-- For integration with WebApi -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\PMS.Application\PMS.Application.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\PMS.Persistence\PMS.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Presentation\PMS.WebApi\PMS.WebApi.csproj" />
  </ItemGroup>

</Project>
